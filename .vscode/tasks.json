{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "iOS: Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build-ios.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "iOS: Test",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/test-ios.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "iOS: Run Simulator",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run-simulator.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
